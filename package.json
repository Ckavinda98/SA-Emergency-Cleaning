{
  "name": "sa-emergency-cleaning",
  "version": "1.0.0",
  "type": "module",
  "description": "SA Emergency Cleaning App",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:build": "vite build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/preferences": "^7.0.0",
    "@prisma/client": "^6.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "vite": "^6.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
