# Copy this file to .env (same folder) and fill in your values. .env is never committed (see .gitignore).
# Step-by-step help: docs/hosting/00-START-HERE.md

# ---------- Database (PostgreSQL) ----------
# Your PC: the Neon "dev" branch (docs/hosting/01-database-neon.md) or a local Docker Postgres.
# DATABASE_URL = the POOLED string (host contains "-pooler"), with &pgbouncer=true&connect_timeout=15 added
# DIRECT_DATABASE_URL = the DIRECT string (no "-pooler"), with &connect_timeout=15 added
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Tests only: a SEPARATE database (Neon "test" branch). npm test deletes everything in it.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ---------- API ----------
PORT=5000
# Any long random text. Make new ones with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
# Websites allowed to call the API (comma separated, no slash at the end)
CORS_ORIGIN="http://localhost:3000"

# ---------- File storage ----------
# inline   = photos stay inside the job row (no setup needed, fine on your PC)
# supabase = photos go to the Supabase bucket (docs/hosting/02-file-storage-supabase.md)
STORAGE_DRIVER="inline"
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET="sacc-files"
SUPABASE_PUBLIC_BUCKET="true"

# ---------- Demo users ----------
# Password given to every demo user by: node prisma/seed.js
SEED_PASSWORD="Password123!"

# ---------- Web app (Vite reads these when it builds) ----------
VITE_API_BASE="http://localhost:5000/api"
# Optional: Google Maps address lookup (browser key restricted to your websites)
# VITE_GOOGLE_MAPS_API_KEY=""

# ---------- Azure production (later; not read by the code yet) ----------
# AZURE_STORAGE_CONNECTION_STRING=""
# AZURE_STORAGE_CONTAINER_NAME="incident-media"
