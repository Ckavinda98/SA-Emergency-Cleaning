// Prisma Schema - Local SQLite for Development (Translates 100% to Azure PostgreSQL)
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String
  name           String
  role           String        // CUSTOMER, TECHNICIAN, ADMIN, CONFIG
  refreshToken   String?
  lastLoginAt    DateTime?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  technicianId   String?       @unique
  technician     Technician?   @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Organization {
  id                 String              @id @default(uuid())
  businessName       String
  abn                String
  primaryContactName String
  phoneNumber        String
  email              String              @unique
  membershipPlan     String              @default("business")
  paymentMethod      String              @default("PayTo Bank Direct")
  paymentType        String              @default("DIRECT_DEBIT")
  subscriptionStatus String              @default("ACTIVE")
  consecutiveMonths  Int                 @default(8)
  pointsBalance      Int                 @default(1592)
  calloutsUsed       Int                 @default(1)
  users              User[]
  locations          Location[]
  emergencyRequests  EmergencyRequest[]
  redemptionRequests RedemptionRequest[]
  invoices           Invoice[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Location {
  id                   String              @id @default(uuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  address              String
  contactName          String
  contactPhone         String
  accessInstructions   String?
  securityNotes        String?
  emergencyRequests    EmergencyRequest[]
  redemptionRequests   RedemptionRequest[]
  createdAt            DateTime            @default(now())
}

model Technician {
  id          String   @id @default(uuid())
  name        String
  phone       String
  status      String   @default("AVAILABLE") // AVAILABLE, ON_SITE, OFF_DUTY
  rating      Float    @default(4.9)
  activeJobId String?
  user        User?
  createdAt   DateTime @default(now())
}

model EmergencyRequest {
  id                 String   @id @default(uuid())
  jobNumber          String   @unique // e.g. SACC-2026-0812
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  locationId         String
  location           Location @relation(fields: [locationId], references: [id])
  customerName       String
  locationName       String
  address            String
  category           String
  description        String
  affectedArea       Float?
  incidentTime       DateTime @default(now())
  isOngoing          Boolean  @default(false)
  isSafeToAccess     Boolean  @default(true)
  onsiteContact      String
  onsitePhone        String
  accessInstructions String?
  accessRestrictions String?
  parkingInstructions String?
  status             String   @default("NEW") // NEW, SUBMITTED, UNDER_REVIEW, MORE_INFO_REQUIRED, ACCEPTED, TECHNICIAN_ASSIGNED, TRAVELLING, ARRIVED, IN_PROGRESS, COMPLETED, REPORT_ISSUED, CLOSED
  submittedAt        DateTime @default(now())
  targetAttendanceAt DateTime?
  technicianName     String?
  photosJson         String   @default("[]") // JSON string of photo URLs
  videosJson         String   @default("[]") // JSON string of video URLs
  timerMinutes       Int      @default(0)
  timerActive        Boolean  @default(false)
  extensionRequested Boolean  @default(false)
  extensionApproved  Boolean  @default(false)
  additionalCharges  Float    @default(0)
  workStartedAt      DateTime?
  completedAt        DateTime?
  source             String   @default("PORTAL")
  statusEvents       JobStatusEvent[]
  createdAt          DateTime @default(now())
}

model RedemptionRequest {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  locationId       String
  location         Location     @relation(fields: [locationId], references: [id])
  serviceCode      String
  serviceName      String
  quantity         Float
  calculatedPoints Int
  status           String       @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, SCHEDULED
  createdAt        DateTime     @default(now())
}

model SystemDynamicConfig {
  configKey   String   @id
  configValue String   // JSON string storing dynamic rules, plans, rates, disclaimers
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id             String       @id @default(uuid())
  invoiceNumber  String       @unique // e.g. INV-2026-001
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  description    String
  amount         Float
  status         String       @default("PAID") // PAID, PENDING, OVERDUE
  paymentMethod  String       @default("PayTo Bank Direct")
  dueDate        DateTime     @default(now())
  paidAt         DateTime?    @default(now())
  createdAt      DateTime     @default(now())
}

model JobStatusEvent {
  id              String           @id @default(uuid())
  jobId           String
  job             EmergencyRequest @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedByUserId String?
  notes           String?
  createdAt       DateTime         @default(now())

  @@index([jobId, createdAt])
}

// Every data change made through the API: who did what, to which record, before/after values.
// No foreign key to User, so the history survives account deletion.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  userRole   String?
  action     String   // e.g. JOB_CREATED, JOB_STATUS_CHANGED, PLAN_CHANGED, REDEMPTION_APPROVED
  entityType String   // Organization, EmergencyRequest, Technician, Location, RedemptionRequest, Invoice, SystemDynamicConfig
  entityId   String?
  diffJson   String?  // JSON string with before/after values
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Every sign-in attempt, sign-out and rejected token refresh.
model LoginLog {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  success   Boolean
  role      String?
  event     String   @default("LOGIN_SUCCESS") // LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, REFRESH_FAILED
  reason    String?  // UNKNOWN_EMAIL, WRONG_PASSWORD, MISSING_FIELDS, INVALID_TOKEN, TOKEN_NOT_CURRENT
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}
