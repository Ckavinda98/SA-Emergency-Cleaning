// Prisma Schema - PostgreSQL everywhere: your PC (Neon dev branch or Docker), the free demo (Neon)
// and production (Azure Database for PostgreSQL). Only the connection strings change.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // pooled connection string (Neon "-pooler" host)
  directUrl = env("DIRECT_DATABASE_URL")   // direct connection string, used by prisma db push / migrate
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String
  name           String
  role           String        // CUSTOMER, TECHNICIAN, ADMIN, CONFIG
  refreshToken   String?
  lastLoginAt    DateTime?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  technicianId   String?       @unique
  technician     Technician?   @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Organization {
  id                 String              @id @default(uuid())
  businessName       String
  abn                String
  primaryContactName String
  phoneNumber        String
  email              String              @unique
  membershipPlan     String              @default("business")
  paymentMethod      String              @default("PayTo Bank Direct")
  paymentType        String              @default("DIRECT_DEBIT")
  subscriptionStatus String              @default("ACTIVE")
  consecutiveMonths  Int                 @default(0) // no longer used: worked out from activationDate
  pointsBalance      Int                 @default(0) // sum of PointsEntry, kept in step for quick reads
  calloutsUsed       Int                 @default(0) // this month, all sites together (each site keeps its own)
  // Agreement cl. 1, 3, 4, 5, 6, 14.7, 15, 19.2
  membershipNumber   String?             @unique
  activationDate     DateTime            @default(now())
  billingFrequency   String              @default("MONTHLY") // MONTHLY, ANNUAL
  paymentNoticeAt    DateTime?           // payment failed and the member was told; drives suspension (cl. 4.4)
  cancellationReview Boolean             @default(false) // unpaid 30 days (cl. 5.4)
  cancelledAt        DateTime?
  refundAmount       Float?
  pendingPlan        String?             // downgrade waiting for the next billing period (cl. 6.3)
  pendingPlanFrom    DateTime?
  lockedRatesJson    String?             // rates fixed for the membership period (cl. 15.2)
  ratesLockedUntil   DateTime?
  lastCalloutAt      DateTime?           // for the 30-day cancellation rule (cl. 5.2)
  referralCode       String?             @unique
  referredById       String?
  referralRewarded   Boolean             @default(false)
  bonusCallouts      Int                 @default(0) // Gold level: 1 per membership year (cl. 15)
  bonusCalloutYear   Int                 @default(0)
  outsideMetroApproved Boolean           @default(false)
  pointsEntries      PointsEntry[]
  users              User[]
  locations          Location[]
  emergencyRequests  EmergencyRequest[]
  redemptionRequests RedemptionRequest[]
  invoices           Invoice[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Location {
  id                   String              @id @default(uuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  address              String
  contactName          String
  contactPhone         String
  accessInstructions   String?
  securityNotes        String?
  membershipPlan       String?             // each site holds its own plan; empty = the company plan (cl. 17.1)
  calloutsUsed         Int                 @default(0) // this month, for this site only
  serviceArea          String              @default("METRO") // METRO, OUTSIDE_METRO (cl. 18)
  areaApproved         Boolean             @default(true) // outside-metro sites need SACC approval
  travelKm             Float?              // one way from the Adelaide GPO, confirmed by SACC
  emergencyRequests    EmergencyRequest[]
  redemptionRequests   RedemptionRequest[]
  createdAt            DateTime            @default(now())
}

model Technician {
  id          String   @id @default(uuid())
  name        String
  phone       String
  status      String   @default("AVAILABLE") // AVAILABLE, ON_SITE, OFF_DUTY
  rating      Float    @default(4.9)
  activeJobId String?
  user        User?
  createdAt   DateTime @default(now())
}

model EmergencyRequest {
  id                 String   @id @default(uuid())
  jobNumber          String   @unique // e.g. SACC-2026-0812
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  locationId         String
  location           Location @relation(fields: [locationId], references: [id])
  customerName       String
  locationName       String
  address            String
  category           String
  description        String
  affectedArea       Float?
  incidentTime       DateTime @default(now())
  isOngoing          Boolean  @default(false)
  isSafeToAccess     Boolean  @default(true)
  onsiteContact      String
  onsitePhone        String
  accessInstructions String?
  accessRestrictions String?
  parkingInstructions String?
  status             String   @default("NEW") // NEW, SUBMITTED, UNDER_REVIEW, MORE_INFO_REQUIRED, ACCEPTED, TECHNICIAN_ASSIGNED, TRAVELLING, ARRIVED, IN_PROGRESS, COMPLETED, REPORT_ISSUED, CLOSED
  submittedAt        DateTime @default(now())
  targetAttendanceAt DateTime?
  technicianName     String?
  photosJson         String   @default("[]") // JSON string of photo URLs
  videosJson         String   @default("[]") // JSON string of video URLs
  timerMinutes       Int      @default(0)
  timerActive        Boolean  @default(false)
  extensionRequested Boolean  @default(false)
  extensionApproved  Boolean  @default(false)
  additionalCharges  Float    @default(0)
  workStartedAt      DateTime?
  completedAt        DateTime?
  source             String   @default("PORTAL")
  // Call capture (Operations SOP) and coverage (cl. 9, 10)
  waterType          String?  // NONE, CLEAN, GREY, BLACK
  hazardsJson        String   @default("[]")
  coverageWarningsJson String @default("[]")
  // Acknowledgment and response clock (cl. 13)
  acknowledgedAt     DateTime?
  responseClockStartAt DateTime?
  targetWindowFrom   DateTime?
  priorityTier       Int      @default(4) // 1 Premium, 2 Business, 3 Essential, 4 non-member
  planAtBooking      String?
  // Triage (SOP): COVERED, SPECIALIST, EXCLUDED, GREY_AREA
  triage             String?
  triageNotes        String?
  triagedAt          DateTime?
  // Call-out and charges (cl. 3, 7, 8)
  calloutType        String?  // INCLUDED, ADDITIONAL, NONE (not used: quote, decline, cancelled before dispatch)
  usedBonusCallout   Boolean  @default(false)
  earlyActivation    Boolean  @default(false)
  surchargeAmount    Float    @default(0)
  surchargeReason    String?
  technicianCount    Int      @default(1)
  disposalJson       String   @default("[]") // [{ item, cost }]
  travelKm           Float?
  otherCharges       Float    @default(0)
  otherChargesNote   String?
  // On site (SOP, cl. 10.2, 12.4)
  measuredArea       Float?
  quoteAmount        Float?
  quoteStatus        String?  // PENDING, ACCEPTED, DECLINED
  reclassifyReason   String?
  missedAccessAt     DateTime?
  missedAccessJson   String?  // { waitedMinutes, calls, entrancePhoto }
  cancelledAt        DateTime?
  cancellationFee    Float    @default(0)
  // Service report (Service Report Template)
  beforePhotosJson   String   @default("[]")
  afterPhotosJson    String   @default("[]")
  causeOfIncident    String?
  surfacesAffected   String?
  methodUsed         String?
  equipmentUsed      String?
  productsUsed       String?
  equipmentLeft      String?
  equipmentCollectionAt DateTime?
  recommendations    String?
  checklistJson      String   @default("{}")
  siteRepName        String?
  siteRepSignature   String?  // signature image (data URL)
  signedOffAt        DateTime?
  reportNumber       String?  @unique
  reportIssuedAt     DateTime?
  chargesJson        String?  // frozen charges when the report is issued
  extrasInvoiceId    String?
  goodwillCredited   Boolean  @default(false)
  reattendOfId       String?  // workmanship guarantee re-attend (cl. 20)
  statusEvents       JobStatusEvent[]
  createdAt          DateTime @default(now())
}

model RedemptionRequest {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  locationId       String
  location         Location     @relation(fields: [locationId], references: [id])
  serviceCode      String
  serviceName      String
  quantity         Float
  calculatedPoints Int          @default(0) // points applied (1 point = $1, cl. 14.2)
  notes            String?
  quoteAmount      Float?       // SACC's price for the service, ex GST
  discountPercent  Float        @default(0) // Silver/Gold loyalty discount (cl. 15)
  balanceDue       Float?       // price after points, invoiced to the member
  scheduledFor     DateTime?
  status           String       @default("PENDING_APPROVAL") // PENDING_APPROVAL (awaiting quote), APPROVED (booked, points deducted), REJECTED, CANCELLED (points restored)
  createdAt        DateTime     @default(now())
}

model SystemDynamicConfig {
  configKey   String   @id
  configValue String   // JSON string storing dynamic rules, plans, rates, disclaimers
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id             String       @id @default(uuid())
  invoiceNumber  String       @unique // e.g. INV-2026-001
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  description    String
  amount         Float
  status         String       @default("PAID") // PAID, PENDING, OVERDUE
  kind           String       @default("MEMBERSHIP") // MEMBERSHIP, EXTRAS, REDEMPTION, REFUND
  gst            Float        @default(0)
  jobId          String?
  linesJson      String?
  paymentMethod  String       @default("PayTo Bank Direct")
  dueDate        DateTime     @default(now())
  paidAt         DateTime?    @default(now())
  createdAt      DateTime     @default(now())
}

model JobStatusEvent {
  id              String           @id @default(uuid())
  jobId           String
  job             EmergencyRequest @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedByUserId String?
  notes           String?
  createdAt       DateTime         @default(now())

  @@index([jobId, createdAt])
}

// Every data change made through the API: who did what, to which record, before/after values.
// No foreign key to User, so the history survives account deletion.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  userRole   String?
  action     String   // e.g. JOB_CREATED, JOB_STATUS_CHANGED, PLAN_CHANGED, REDEMPTION_APPROVED
  entityType String   // Organization, EmergencyRequest, Technician, Location, RedemptionRequest, Invoice, SystemDynamicConfig
  entityId   String?
  diffJson   String?  // JSON string with before/after values
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Every sign-in attempt, sign-out and rejected token refresh.
model LoginLog {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  success   Boolean
  role      String?
  event     String   @default("LOGIN_SUCCESS") // LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, REFRESH_FAILED
  reason    String?  // UNKNOWN_EMAIL, WRONG_PASSWORD, MISSING_FIELDS, INVALID_TOKEN, TOKEN_NOT_CURRENT
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// Reward points ledger (cl. 14): every point earned or spent, so points can expire 12 months after they were earned
model PointsEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  points         Int          // + earned, - spent / expired / cancelled
  remaining      Int          @default(0) // for earned entries: points not yet spent or expired
  reason         String       // OPENING, FEES, UNUSED_CALLOUT, REFERRAL, GOODWILL, REDEMPTION, REDEMPTION_RESTORED, EXPIRED, CANCELLED, ADJUSTMENT
  note           String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// One row per uploaded file (photo, video, avatar, report). The job rows keep only the file's URL
// in photosJson / videosJson / beforePhotosJson / afterPhotosJson.
model FileAttachment {
  id             String   @id @default(uuid())
  jobId          String?  // set when the request is saved (photos are uploaded before the job exists)
  organizationId String?
  kind           String   // PHOTO, VIDEO, AVATAR, REPORT
  path           String   @unique // e.g. uploads/<orgId>/2026-11/<uuid>.jpg
  url            String
  size           Int
  mimeType       String
  uploadedBy     String?  // User.id
  createdAt      DateTime @default(now())

  @@index([jobId])
  @@index([organizationId])
}
